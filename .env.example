# Studio intake form (src/app/api/inquiries/route.ts)
#
# Server-side only — never exposed to the client. Without these, the
# /contact form will show a friendly error on submit instead of failing
# silently (see GENERIC_ERROR in the API route).

# Supabase project storing studio_inquiries (see supabase/migrations).
# Use the service role key here, NOT the anon/public key — it's required to
# bypass RLS from the server route, and must never be prefixed with
# NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email notification on new inquiries via Resend (resend.com).
# If RESEND_API_KEY is unset, inquiries are still stored — submission just
# skips the email step and logs a warning.
RESEND_API_KEY=
# Defaults to aiformstudio@gmail.com if unset.
CONTACT_NOTIFICATION_EMAIL=
# Must be a Resend-verified sender address/domain in production.
RESEND_FROM_EMAIL="AiForm Studio <onboarding@resend.dev>"
