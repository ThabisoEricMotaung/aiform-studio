# Studio intake form (src/app/api/inquiries/route.ts)
#
# Server-side only — never exposed to the client. Without these, the
# /contact form will show a friendly error on submit instead of failing
# silently (see GENERIC_ERROR in the API route).

# Supabase project storing studio_inquiries (see supabase/migrations).
# Use a new-format secret key here, NOT the publishable/anon key. It is
# required to bypass RLS from the server route and must never be prefixed
# with NEXT_PUBLIC_. SUPABASE_SERVICE_ROLE_KEY remains supported as a
# legacy fallback during migration.
SUPABASE_URL=https://cczfkdtayvfzlhekcjtz.supabase.co
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: email notification on new inquiries via Resend (resend.com).
# If RESEND_API_KEY is unset, inquiries are still stored — submission just
# skips the email step and logs a warning.
RESEND_API_KEY=
# Defaults to aiformstudio@gmail.com if unset.
CONTACT_NOTIFICATION_EMAIL=
# Must be a Resend-verified sender address/domain in production.
RESEND_FROM_EMAIL="AiForm Studio <onboarding@resend.dev>"

# Alternative contact methods (src/components/contact/). Public destination
# config only — safe to expose to the client, hence NEXT_PUBLIC_. Each
# action hides itself gracefully if its variable is unset.

# Calendly scheduling page/event URL, e.g. https://calendly.com/aiformstudio/studio-conversation
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/aiformstudio/30min

# Studio WhatsApp number in international format, digits only (country code,
# no +, spaces or dashes), e.g. 27821234567
NEXT_PUBLIC_STUDIO_WHATSAPP=27788148142

# LeOra NDA execution. Server-only. Enable only after migration + production verification.
LEORA_SIGNING_ENABLED=false
# SHA-256 of a cryptographically random signing code (at least 32 characters).
# Share the raw code separately with the intended signatory; never put it in a URL.
LEORA_SIGNING_CODE_SHA256=
LEORA_SIGNING_EXPIRES_AT=
# Independent cryptographically random secret (at least 32 characters).
DOCUMENT_SIGNING_SESSION_SECRET=

# LeOra private-document access (/documents/leora-group/access). General view
# permission for LeOra's private commercial documents (Preliminary Scope and
# future LeOra documents). Entirely separate credential from the NDA signing
# code above: different secret, different session cookie, different route
# scope. This session grants no signing, countersigning, or database-write
# authority — it never satisfies, and is never satisfied by, the NDA signing
# session, Studio countersigning, or Studio admin authentication. Do not
# reuse the NDA signing code's raw value here.
LEORA_ACCESS_ENABLED=false
# SHA-256 of a cryptographically random access code (at least 32 characters).
# Share the raw code separately with the intended LeOra recipient; never put
# it in a URL.
LEORA_ACCESS_CODE_SHA256=
# Independent cryptographically random secret (at least 32 characters).
LEORA_ACCESS_SESSION_SECRET=

# Studio-only countersigning (/documents/leora-group/nda/countersign). Entirely
# separate credential from the client signing code above: different secret,
# different session cookie, different route scope. Never share this code with
# the client, and never reuse the client's signing code here.
STUDIO_COUNTERSIGN_ENABLED=false
# SHA-256 of a cryptographically random Studio countersigning code (at least 32 characters).
STUDIO_COUNTERSIGN_CODE_SHA256=
# Independent cryptographically random secret (at least 32 characters).
STUDIO_COUNTERSIGN_SESSION_SECRET=

# Studio Console Auth. Server-only; see docs/studio-auth.md for setup.
# Use a publishable key (sb_publishable_), NEVER a service-role/secret key.
SUPABASE_PUBLISHABLE_KEY=
# UUID of the pre-provisioned Supabase Auth administrator; not an email.
STUDIO_ADMIN_USER_ID=
# Login restriction only; the verified UUID above determines authorization.
STUDIO_ADMIN_EMAIL=
# Exact origin without a trailing slash. Local: http://localhost:3000
STUDIO_APP_ORIGIN=https://www.aiformstudio.co.za

# Product Review client access (/reviews). Server-only. Signs the per-review
# client session cookie and namespaces its rate-limit keys. Independent
# cryptographically random secret (at least 32 characters), distinct from
# every LeOra/NDA/countersign secret. Rotating it signs out every client
# session; access codes themselves stay valid. Requires migration
# 20260924090000_create_studio_review_client_access.sql. Missing -> the
# portal fails closed (Studio administrators can still open reports).
REVIEW_ACCESS_SESSION_SECRET=
